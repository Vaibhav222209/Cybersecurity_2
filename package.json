{
  "name": "archer-security",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Archer Security — a cybersecurity operations workspace by Vaibhav Thakur",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.1"
  },
  "engines": {
    "node": ">=22"
  }
}
